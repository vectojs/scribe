{
  "name": "scribe",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vectojs/scribe.git"
  },
  "bugs": {
    "url": "https://github.com/vectojs/scribe/issues"
  },
  "homepage": "https://github.com/vectojs/scribe#readme",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "format:check": "oxfmt --check \"src/**/*.{js,ts,jsx,tsx,mjs,cjs,json}\"",
    "lint": "oxlint --deny-warnings src test",
    "format": "oxfmt --write \"src/**/*.{js,ts,jsx,tsx,mjs,cjs,json}\"",
    "lint:biome": "biome lint",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "check": "bun run format:check && bun run lint && bun run lint:md",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@vectojs/core": "1.39.1",
    "@vectojs/markdown": "0.23.0",
    "@vectojs/styles": "0.3.3",
    "@vectojs/ui": "2.20.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "^1.3.0",
    "@vectojs/devtools": "0.11.2",
    "carryctx": "0.7.0",
    "lefthook": "^2.1.10",
    "markdownlint-cli2": "^0.23.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2",
    "vite": "^5.2.11",
    "wrangler": "^4.110.0"
  }
}
